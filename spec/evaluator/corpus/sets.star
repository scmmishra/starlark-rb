s = set([3, 1, 2, 1])
s.add(4)
s.add(1)
s.discard(3)
s.discard(99)
print(s, len(s), 2 in s, sorted(s), set(), set('ab'.elems()), set({'x': 1}))
t = set([2, 5])
print(s | t, s & t, s - t, s ^ t, s.union([7]), s.intersection([1, 2]), s.difference([1]), s.symmetric_difference([1, 9]), s.issubset([1, 2, 4, 5]), s.issuperset([1]), s.pop(), s)
s.remove(2)
s.update([8, 9])
print(s, s == set([4, 8, 9]), s != set())
